{
  "version": "manual",
  "description": "Compact manually curated protocol for longitudinal ICU trajectory reasoning over MIMIC-IV and eICU. The protocol emphasizes high-coverage temporal physiological deterioration patterns aligned with intervention prediction tasks rather than universal clinical guidelines.",
  "intended_use": {
    "primary_task": "future intervention risk prediction (6h/12h)",
    "communication_mode": "structured patient-state packets",
    "state_dimensions": [
      "hemodynamic_instability_score",
      "respiratory_instability_score",
      "renal_instability_score",
      "metabolic_instability_score",
      "systemic_inflammation_score"
    ],
    "note": "Protocol constraints guide persistent patient-state evolution rather than replace clinical reasoning."
  },
  "core_features": [
    "hr",
    "map",
    "rr",
    "spo2",
    "temp",
    "lactate",
    "creatinine",
    "wbc",
    "sodium",
    "potassium",
    "bicarbonate",
    "glucose"
  ],
  "rules": [
    {
      "rule_id": "SHOCK_01",
      "name": "Lactate Rising Suggests Hypoperfusion",
      "category": "shock_hemodynamic",
      "trigger": [
        {
          "feature": "lactate",
          "op": "trend_is",
          "value": "rising",
          "window_hours": 6,
          "min_occurrences": 2
        }
      ],
      "state_update": {
        "hemodynamic_instability_score": {
          "delta": 1.0,
          "weight": 0.9
        }
      },
      "risk": "shock_progression",
      "severity": "high",
      "relevant_targets": [
        "vasopressor_signal",
        "any_deterioration"
      ],
      "counterfactual_candidates": [
        "fluid_resuscitation_bolus",
        "lactate_clearance_targeting"
      ]
    },
